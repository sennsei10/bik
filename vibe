<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Rogue Gallery — Petsama Bengaluru</title>
<meta name="description" content="Meet the famously unhinged, delightfully spoiled, and highly demanding clients of Petsama Bengaluru. Take the vibe quiz to find your spirit pet!">

<!-- Elegant editorial & premium modern fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --cream: #FAF6F0;
    --cream-dark: #F0E6DC;
    --red: #C1272D;
    --red-dark: #7A1418;
    --ink: #18130F;
    --ink-soft: #5C4D43;
    --gold: #E5A93C;
    --sakura: #F3C1C6;
    --sage: #C5E0C8;
    --blue: #A2D2FF;

    --border-thick: 3px solid var(--ink);
    --border-thin: 2px solid var(--ink);
    --shadow-neobrutal: 6px 6px 0px var(--ink);
    --shadow-neobrutal-hover: 10px 10px 0px var(--ink);
    --shadow-small: 3px 3px 0px var(--ink);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cream);
    color: var(--ink);
    overflow-x: hidden;
    padding-bottom: 80px;
  }

  h1, h2, h3, .logo-text {
    font-family: 'Fraunces', serif;
    font-weight: 900;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- HEADER & BRANDING --- */
  header {
    background: var(--cream);
    border-bottom: var(--border-thick);
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 246, 240, 0.95);
    backdrop-filter: blur(8px);
  }

  header .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-text {
    font-size: 24px;
    color: var(--red);
  }

  .btn-back {
    font-weight: 800;
    font-size: 14px;
    padding: 8px 18px;
    background: #fff;
    border: var(--border-thin);
    border-radius: 50px;
    box-shadow: var(--shadow-small);
    text-decoration: none;
    color: var(--ink);
    transition: all 0.15s ease;
  }

  .btn-back:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  /* --- HERO HEROIC CHAOS --- */
  .hero {
    text-align: center;
    padding: 80px 0 40px;
    background-image: radial-gradient(var(--cream-dark) 2px, transparent 2px);
    background-size: 24px 24px;
    border-bottom: var(--border-thick);
  }

  .eyebrow {
    display: inline-block;
    background: var(--gold);
    border: var(--border-thin);
    padding: 6px 16px;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-small);
  }

  .hero h1 {
    font-size: 56px;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--ink);
  }

  .hero h1 span {
    color: var(--red);
    font-style: italic;
  }

  .hero p {
    font-size: 18px;
    color: var(--ink-soft);
    max-width: 650px;
    margin: 0 auto 30px;
    line-height: 1.6;
    font-weight: 500;
  }

  /* --- INTERACTIVE MINI-QUIZ --- */
  .quiz-section {
    background: var(--sakura);
    border-bottom: var(--border-thick);
    padding: 50px 0;
  }

  .quiz-box {
    background: #fff;
    border: var(--border-thick);
    border-radius: 24px;
    max-width: 600px;
    margin: 0 auto;
    padding: 40px;
    box-shadow: var(--shadow-neobrutal);
    text-align: center;
    position: relative;
  }

  .quiz-box h3 {
    font-size: 28px;
    margin-bottom: 24px;
  }

  .quiz-option {
    display: block;
    width: 100%;
    background: var(--cream);
    border: var(--border-thin);
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    text-align: left;
    transition: all 0.1s ease;
  }

  .quiz-option:hover {
    background: var(--gold);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-small);
  }

  .quiz-result {
    display: none;
    animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes popIn {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .result-img-wrap {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: var(--border-thick);
    overflow: hidden;
    margin: 0 auto 20px;
    box-shadow: var(--shadow-small);
  }

  .result-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- FILTER BUTTONS --- */
  .filter-area {
    padding: 50px 0 20px;
    text-align: center;
  }

  .filter-title {
    font-size: 28px;
    margin-bottom: 24px;
  }

  .filters-wrap {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .filter-btn {
    background: #fff;
    border: var(--border-thin);
    padding: 10px 20px;
    border-radius: 50px;
    font-weight: 800;
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: var(--shadow-small);
  }

  .filter-btn:hover, .filter-btn.active {
    background: var(--ink);
    color: #fff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--gold);
  }

  /* --- GALLERY GRID --- */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }

  .card {
    background: #fff;
    border: var(--border-thick);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-neobrutal);
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card:hover {
    transform: translate(-5px, -5px);
    box-shadow: var(--shadow-neobrutal-hover);
  }

  .img-container {
    height: 250px;
    border-bottom: var(--border-thick);
    position: relative;
    background: var(--cream-dark);
  }

  .img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: 12px;
    right: 12px;
    font-weight: 800;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 50px;
    border: var(--border-thin);
    box-shadow: 2px 2px 0 var(--ink);
    text-transform: uppercase;
  }

  /* Dynamic Tag Colors */
  .tag.fight { background: var(--red); color: #fff; }
  .tag.chill { background: var(--sage); color: var(--ink); }
  .tag.sass { background: var(--sakura); color: var(--ink); }
  .tag.nerd { background: var(--blue); color: var(--ink); }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
  }

  .card-title {
    font-size: 22px;
    margin-bottom: 6px;
    color: var(--ink);
  }

  .subtitle {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--red-dark);
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .desc {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .stat-row {
    border-top: 1.5px dashed var(--cream-dark);
    padding-top: 12px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 800;
  }

  .stat-label {
    color: var(--ink-soft);
  }

  .stat-val {
    color: var(--ink);
  }

  /* --- FOOTER BANNER --- */
  .footer-banner {
    background: var(--ink);
    color: var(--cream);
    text-align: center;
    padding: 60px 24px;
    margin-top: 80px;
    border-top: var(--border-thick);
  }

  .footer-banner h2 {
    font-size: 36px;
    margin-bottom: 12px;
  }

  .footer-banner p {
    font-size: 16px;
    color: var(--cream-dark);
    margin-bottom: 24px;
  }

  .btn-cta {
    display: inline-block;
    background: var(--gold);
    color: var(--ink);
    font-weight: 800;
    padding: 12px 28px;
    border-radius: 50px;
    border: var(--border-thin);
    box-shadow: var(--shadow-small);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-cta:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 #fff;
  }

  /* --- RESPONSIVE DECOR --- */
  @media(max-width: 768px) {
    .hero h1 { font-size: 38px; }
    .hero p { font-size: 15px; }
    .quiz-box { padding: 24px; }
    .quiz-box h3 { font-size: 22px; }
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="logo-group">
      <span class="logo-text">🐾 Petsama</span>
    </div>
    <a href="index.html" class="btn-back">← Back to Main</a>
  </div>
</header>

<!-- HERO -->
<section class="hero">
