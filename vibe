        <div class="result-img-wrap">
          <img id="result-img" src="" alt="Spirit Animal">
        </div>
        <p id="result-desc" style="font-weight: 700; margin-bottom: 24px; color: var(--ink-soft);"></p>
        <button class="btn-back" onclick="resetQuiz()">Try Again 🔄</button>
