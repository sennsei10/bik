<script>
  // Simple Quiz Matching Logic
  const spiritAnimals = {
    fight: {
      name: "Sensei Fluff & Little Mac",
      img: "1.jpg",
      desc: "You do not compromise. You do not talk. You enter the ring ready to lay down the law with direct martial arts paws up. We match you with expert wrestling sitters."
    },
    chill: {
      name: "Baron Von Snuggle",
      img: "5bd5719eb61a7c4305d56f7eaa9c7054.jpg",
      desc: "You appreciate the finer things: blanket tunnels, fresh pizza slices on the sofa, and uninterrupted lofi sessions. You expect the best service while you relax."
    },
    sass: {
      name: "Babushka Bella",
      img: "55c267203b80bce71e78984398f0e0be.jpg",
      desc: "You are totally unbothered. Let the volcano explode, let the worlds collide—you have sunglasses, a stunning headscarf, and an iced coffee."
    },
    nerd: {
      name: "Professor Winston",
      img: "6.jpg",
      desc: "You analyze everything down to the decimal point. You read academic literature over your spectacles and require data proof before accepting treats."
    }
  };

  function solveQuiz(vibeKey) {
    const result = spiritAnimals[vibeKey];
    document.getElementById('quiz-content').style.display = 'none';

    document.getElementById('result-title').textContent = "Spirit Client: " + result.name + "!";
    document.getElementById('result-img').src = result.img;
    document.getElementById('result-desc').textContent = result.desc;

    document.getElementById('quiz-result').style.display = 'block';
  }

  function resetQuiz() {
    document.getElementById('quiz-result').style.display = 'none';
    document.getElementById('quiz-content').style.display = 'block';
  }

  // Real-time Card Filtering Logic
  function filterGallery(category, clickedBtn) {
    // Toggle Active Class for Buttons
    const buttons = document.querySelectorAll('.filter-btn');
    buttons.forEach(btn => btn.classList.remove('active'));
    clickedBtn.classList.add('active');

    // Filter Cards
    const cards = document.querySelectorAll('.card');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (category === 'all' || cardCat === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

